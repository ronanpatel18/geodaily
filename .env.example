# Copy to .env.local (git-ignored) and fill in. Vite inlines VITE_* values at build time,
# so on Vercel set the same variable in Project Settings → Environment Variables and redeploy.
#
# Google Maps JavaScript API key. In Google Cloud Console: enable "Maps JavaScript API",
# restrict the key to HTTP referrers (your Vercel domain(s) + http://localhost:5173/*),
# restrict it to the Maps JavaScript API, and set a billing budget alert.
VITE_GOOGLE_MAPS_API_KEY=
